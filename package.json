{
  "name": "dsh-session-navigator",
  "version": "1.0.4",
  "description": "会话资源管理器 (Session Navigator) for DeepSeek Harness: virtual folders, tags, notes, trash and multi-workspace session browsing on top of the native DSH session store.",
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "icon": "./assets/icon.png",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:render": "node test/render-smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "navigator",
    "explorer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anlerway/dsh-session-navigator.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "koffi": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "koffi": {
      "optional": true
    }
  }
}
